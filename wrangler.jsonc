{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maeum-signal-poll",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./.dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/api/*", "/", "/display", "/display/*", "/manual", "/manual/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ],
  "vars": {
    "ROOM_TTL_HOURS": "24"
  },
  "observability": {
    "enabled": true
  }
}
